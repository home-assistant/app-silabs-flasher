#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start universal-silabs-flasher
# ==============================================================================

set -e

declare device
declare firmware_url
declare exit_status
declare options
declare old_key
declare -a flasher_args=()

function cleanup() {
    exit_status=$?
    bashio::log.info "universal-silabs-flasher-up script exited with code ${exit_status}"
    echo "${exit_status}" > /run/s6-linux-init-container-results/exitcode

    /run/s6/basedir/bin/halt
}
trap cleanup EXIT

# Function to check if the device is Home Assistant Yellow
function is_home_assistant_yellow {
    # First, ensure the device is /dev/ttyAMA1
    if [ "${device}" != "/dev/ttyAMA1" ]; then
        return 1
    fi

    # Check the known paths for Home Assistant Yellow
    local paths=(
        "/sys/devices/platform/soc/fe201800.serial/tty/ttyAMA1"
        "/sys/devices/platform/soc/fe201800.serial/fe201800.serial:0/fe201800.serial:0.0/tty/ttyAMA1"
        "/sys/devices/platform/axi/1000120000.pcie/1f0003c000.serial/tty/ttyAMA1"
        "/sys/devices/platform/axi/1000120000.pcie/1f0003c000.serial/1f0003c000.serial:0/1f0003c000.serial:0.0/tty/ttyAMA1"
    )
    for path in "${paths[@]}"; do
        if [ -d "${path}" ]; then
            return 0
        fi
    done
    return 1
}

# Delete old options
options=$(bashio::app.options)
for old_key in 'bootloader_baudrate' 'ezsp_baudrate' 'flow_control'; do
    if bashio::jq.exists "${options}" ".${old_key}"; then
        bashio::log.info "Removing ${old_key}"
        bashio::app.option "${old_key}"
    fi
done

if ! bashio::config.has_value 'device'; then
    bashio::exit.nok "No device selected, set the 'device' option."
fi

if ! bashio::config.has_value 'firmware_url'; then
    bashio::exit.nok "No firmware selected, set the 'firmware_url' option. This app no longer bundles firmware."
fi

device=$(bashio::config 'device')
firmware_url=$(bashio::config 'firmware_url')

if bashio::config.true 'verbose'; then
    flasher_args+=(-v)
fi

flasher_args+=(--device "${device}")

if bashio::config.has_value 'profile'; then
    if bashio::config.has_value 'probe_methods' || bashio::config.has_value 'bootloader_reset'; then
        bashio::exit.nok "The 'profile' option cannot be combined with 'probe_methods' or 'bootloader_reset'."
    fi
else
    if bashio::config.has_value 'probe_methods'; then
        flasher_args+=(--probe-methods "$(bashio::config 'probe_methods')")
    fi

    if bashio::config.has_value 'bootloader_reset'; then
        flasher_args+=(--bootloader-reset "$(bashio::config 'bootloader_reset')")
    elif is_home_assistant_yellow; then
        bashio::log.info "Detected Home Assistant Yellow"
        flasher_args+=(--bootloader-reset yellow)
    fi
fi

flasher_args+=(flash --firmware "${firmware_url}")

if bashio::config.has_value 'profile'; then
    flasher_args+=(--profile "$(bashio::config 'profile')")
fi

bashio::log.info "Starting universal-silabs-flasher with ${device} and firmware ${firmware_url}"

# The flasher draws a progress bar that redraws itself in place using carriage
# returns. Make it print a plain line every few seconds instead, so the
# progress is readable in the app log.
export TQDM_MININTERVAL=5
export TQDM_BAR_FORMAT=$'{desc}: {n_fmt}{unit}\n'

set -o pipefail
universal-silabs-flasher "${flasher_args[@]}" 2>&1 | tr -d '\r'
bashio::log.info "Flashing completed successfully"
